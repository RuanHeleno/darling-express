# Frontend public runtime variables
EXPO_PUBLIC_API_URL=http://localhost:8000

# Non-secret backend runtime knobs (all backend secrets live in .secrets/* Docker secret files)
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
REDIS_URL=redis://redis:6379/0
